---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import profileImage from "@/assets/images/profile.png";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="hero">
      <div class="hero-backdrop" aria-hidden="true"></div>

      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow rise-in">
            Tech notes · Project practice · Everyday thoughts
          </p>

          <h1
            class="rise-in mt-4 text-4xl font-bold sm:text-5xl"
            style="--rise-delay: 60ms"
          >
            Hi, I'm <span class="hero-name">Michael Ma</span>
          </h1>

          <p class="hero-lead rise-in mt-4" style="--rise-delay: 120ms">
            And if you don't know me, now you know.
          </p>

          <div class="hero-actions rise-in mt-6" style="--rise-delay: 180ms">
            <a
              class="hero-btn hero-btn--primary"
              href={getRelativeLocaleUrl(locale, "posts")}
            >
              {t.home.browsePosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </a>
          </div>
        </div>

        <div class="hero-portrait rise-in" style="--rise-delay: 100ms">
          <div class="hero-portrait__frame">
            <Image
              src={profileImage}
              alt={`Portrait of ${config.site.author}`}
              width={368}
              densities={[1, 2]}
              loading="eager"
              fetchpriority="high"
              class="hero-portrait__img"
            />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 3rem 2.5rem;
  }

  /* Localised colour blooms on top of the site-wide ambient grid. */
  .hero-backdrop {
    position: absolute;
    inset: 0 -4rem auto -4rem;
    z-index: -1;
    height: 24rem;
    pointer-events: none;
    background-image:
      radial-gradient(40% 55% at 22% 45%, var(--glow-primary), transparent 70%),
      radial-gradient(
        36% 50% at 76% 35%,
        var(--glow-secondary),
        transparent 70%
      );
    mask-image: radial-gradient(62% 62% at 32% 42%, #000 5%, transparent 78%);
  }

  .hero-inner {
    display: grid;
    gap: 1.75rem;
  }

  .hero-portrait {
    position: relative;
    isolation: isolate;
    width: 7.5rem;
    aspect-ratio: 1;
    order: -1;
    border-radius: 999px;
  }

  /* Soft gradient halo behind the photo. */
  .hero-portrait::after {
    content: "";
    position: absolute;
    inset: -0.4rem;
    z-index: -1;
    border-radius: inherit;
    background-image: linear-gradient(
      140deg,
      var(--accent),
      var(--accent-secondary)
    );
    opacity: 0.35;
    filter: blur(12px);
  }

  .hero-portrait__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: inherit;
    box-shadow: 0 18px 40px -26px rgb(0 0 0 / 0.55);
  }

  /* Zoom towards the face so the crop reads as a portrait, not a landscape. */
  .hero-portrait__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    transform: scale(1.4) translateX(-11%);
    transform-origin: 66% 44%;
  }

  /* Idle float on the frame, pointer parallax on the photo inside it, so the
     card, the photo and the static halo drift at different rates. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-portrait__frame {
      animation: portrait-float 7s ease-in-out infinite;
    }

    .hero-portrait__img {
      transform: scale(1.4) translateX(-11%)
        translate(
          calc(var(--pointer-nx, 0) * 4px),
          calc(var(--pointer-ny, 0) * 4px)
        );
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes portrait-float {
    0%,
    100% {
      transform: translateY(-4px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (min-width: 640px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
    }

    .hero-portrait {
      width: clamp(9rem, 22vw, 11.5rem);
      aspect-ratio: 4 / 5;
      order: 0;
      border-radius: 1.25rem;
    }
  }

  .hero-eyebrow {
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-name {
    background-image: linear-gradient(
      100deg,
      var(--accent),
      var(--accent-secondary)
    );
    background-clip: text;
    color: transparent;
  }

  .hero-lead {
    max-width: 44ch;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    padding: 0.6rem 1.05rem;
    font-weight: 600;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
  }

  .hero-btn--primary {
    background-color: var(--accent);
    color: var(--accent-foreground);
    box-shadow: 0 8px 22px -12px
      color-mix(in oklab, var(--accent) 85%, transparent);
  }

  .hero-btn--primary:hover {
    box-shadow: 0 12px 26px -12px
      color-mix(in oklab, var(--accent) 90%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-btn {
      transition: none;
    }
    .hero-btn:hover {
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
