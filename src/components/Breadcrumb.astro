---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHome from "@/assets/icons/IconHome.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  tags: t.nav.tags,
  resume: t.nav.resume,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
};

// if breadcrumb is Home > Posts > [page] <etc>
// show just "Posts" on page 1; include page number only when > 1
if (breadcrumbList[0] === "posts") {
  const pageNum = Number(breadcrumbList[1] || 1);
  breadcrumbList.splice(
    0,
    2,
    pageNum > 1
      ? `${t.nav.posts} (${t.pagination.page.toLowerCase()} ${pageNum})`
      : t.nav.posts
  );
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with localized [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${decodeSegment(breadcrumbList[1])} ${
      Number(breadcrumbList[2]) === 1
        ? ""
        : `(${t.pagination.page.toLowerCase()} ${breadcrumbList[2]})`
    }`
  );
}
---

<nav class="app-layout mt-8 mb-3" aria-label="breadcrumb">
  <ul class="breadcrumb glass">
    <li>
      <a href={getRelativeLocaleUrl(locale, "")} class="breadcrumb__link">
        <IconHome class="breadcrumb__home" aria-hidden="true" />
        {t.nav.home}
      </a>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) => (
        <li>
          <IconChevronRight class="breadcrumb__sep" aria-hidden="true" />
          {index + 1 === breadcrumbList.length ? (
            <span
              class:list={[
                "breadcrumb__current capitalize",
                { lowercase: index > 0 },
              ]}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
            </span>
          ) : (
            <a
              href={getRelativeLocaleUrl(locale, breadcrumb)}
              class="breadcrumb__link capitalize"
            >
              {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .breadcrumb {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.5rem;
    border-radius: 999px;
    padding: 0.55rem 1.15rem;
    font-size: 0.9375rem;

    /* Accent-tinted glass: a diagonal sheen between the two brand colours
       plus a faint accent ring, so the pill reads as part of the UI chrome. */
    background-color: color-mix(in oklab, var(--accent) 7%, var(--glass-bg));
    background-image: linear-gradient(
      115deg,
      color-mix(in oklab, var(--accent) 14%, transparent),
      transparent 45%,
      color-mix(in oklab, var(--accent-secondary) 14%, transparent)
    );
    border-color: color-mix(in oklab, var(--accent) 32%, var(--glass-border));
    box-shadow: 0 10px 30px -22px
      color-mix(in oklab, var(--accent) 85%, transparent);
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: color-mix(in oklab, var(--accent) 55%, var(--muted-foreground));
    transition: color 0.2s ease;
  }

  .breadcrumb__link:hover {
    color: var(--accent);
  }

  .breadcrumb__home {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent);
  }

  .breadcrumb__sep {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    color: var(--accent);
    opacity: 0.5;
  }

  .breadcrumb__current {
    font-weight: 600;
    color: var(--foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb__link {
      transition: none;
    }
  }
</style>
